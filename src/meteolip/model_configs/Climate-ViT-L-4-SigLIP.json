{
    "embed_dim": 1024,
    "init_logit_bias": -10,
    "custom_text": true,
    "vision_cfg": {
        "image_size": 56,
        "timm_model_name": "vit_large_patch16_siglip_256",
        "timm_model_pretrained": false,
        "timm_pool": "map",
        "timm_proj": "none",
        "timm_model_kwargs": {
            "img_size": 56,
            "patch_size": 4
        }
    },
    "text_cfg": {
        "context_length": 77,
        "vocab_size": 32000,
        "hf_tokenizer_name": "timm/ViT-B-16-SigLIP",
        "tokenizer_kwargs": {
            "clean": "canonicalize"
        },
        "width": 1024,
        "heads": 16,
        "layers": 24,
        "no_causal_mask": true,
        "proj_bias": true,
        "pool_type": "last",
        "norm_kwargs":{
            "eps": 1e-6
        }
    }
}